# ═══════════════════════════════════════════════════════════════
# SmartPPE — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# ── YOLO Model Paths ──────────────────────────────────────────
# Absolute paths to your trained model weight files (.pt)
PPE_MODEL_PATH=C:\path\to\ppe_model\best.pt
FIRE_SMOKE_MODEL_PATH=C:\path\to\fire_smoke_model\best.pt

# ── Inference Settings ────────────────────────────────────────
PPE_CONFIDENCE=0.30
FIRE_CONFIDENCE=0.55
INFERENCE_IMG_SIZE=640
# Milliseconds between inference runs per camera (higher = less CPU)
INFERENCE_INTERVAL_MS=200

# ── Camera Settings ───────────────────────────────────────────
# Laptop webcam device index (usually 0)
LAPTOP_CAMERA_INDEX=0
# Phone camera stream URL (leave empty if not using)
# Example: http://192.168.1.100:8080/video (IP Webcam app)
# Example: rtsp://192.168.1.100:8554/stream (RTSP stream)
PHONE_CAMERA_URL=

# ── Server Settings ──────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frame / Stream Settings ─────────────────────────────────
FRAME_WIDTH=640
FRAME_HEIGHT=480
JPEG_QUALITY=70
STREAM_FPS=15

# ── Frontend Settings (Vite) ─────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000
